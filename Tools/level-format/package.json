{
  "name": "cubehaul3d-level-format",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Reference TypeScript reader and validator for the CubeHaul3D LevelDefinition JSON format (schema v1).",
  "bin": { "validate-level": "./src/cli.ts" },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.17.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
