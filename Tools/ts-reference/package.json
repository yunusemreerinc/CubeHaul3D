{
  "name": "cubehaul3d-ts-reference",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reference tests for the Cube Hunt TypeScript rules, run against a pinned, unmodified checkout of the source.",
  "scripts": {
    "fetch": "node scripts/fetch-source.mjs",
    "test": "node scripts/fetch-source.mjs && vitest run",
    "test:source": "node scripts/fetch-source.mjs && vitest run vendor/cube-hunt/tests",
    "test:new": "node scripts/fetch-source.mjs && vitest run tests",
    "typecheck": "node scripts/fetch-source.mjs && tsc --noEmit",
    "export:examples": "node scripts/fetch-source.mjs && tsx scripts/export-level-examples.ts",
    "export:golden": "node scripts/fetch-source.mjs && tsx scripts/export-golden.ts",
    "check:golden": "node scripts/fetch-source.mjs && tsx scripts/export-golden.ts --check"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
