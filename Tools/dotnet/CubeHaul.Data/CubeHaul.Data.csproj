<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds the Unity sources in Assets/CubeHaul/Scripts/Data outside Unity, against .NET Standard 2.1
    (Unity's API compatibility level), to prove they need nothing from UnityEngine.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>CubeHaul.Data</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/CubeHaul/Scripts/Data/**/*.cs" />
  </ItemGroup>
</Project>
