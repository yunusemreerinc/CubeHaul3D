<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds the Unity sources in Assets/_CubeHaul/Domain outside Unity, against .NET Standard 2.1 (Unity's API compatibility
    level) with no UnityEngine reference, to prove the assembly is engine-free. Mirrors CubeHaul.Domain.asmdef.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CubeHaul.Domain</AssemblyName>
    <RootNamespace>CubeHaul.Domain</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/_CubeHaul/Domain/**/*.cs" />
  </ItemGroup>

</Project>
